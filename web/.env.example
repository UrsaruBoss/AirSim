# Copiaza fisierul ca .env.local (sau editeaza .env.development pentru `npm run dev`). Dupa orice schimbare reporneste `npm run dev`.

# Optional. Fara token, harta foloseste tile-uri intunecate gratuite (CARTO/OSM), fara teren 3D.
# Cu token Cesium Ion (gratuit pe https://ion.cesium.com) primesti teren 3D real si imagistica.
VITE_CESIUM_ION_TOKEN=

# Adresa serverului .NET. Proxy-ul din `npm run dev` trimite /api si /hubs aici (implicit http://localhost:5080).
VITE_SERVER_URL=http://localhost:5080
